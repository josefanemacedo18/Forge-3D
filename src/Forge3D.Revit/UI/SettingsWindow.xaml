<Window x:Class="Forge3D.Revit.UI.SettingsWindow"
        WindowStartupLocation="CenterOwner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forge 3D — Configurações" Width="760" Height="680" MinWidth="620" MinHeight="520">
  <Window.Resources>
    <ResourceDictionary Source="/Forge3D.Revit;component/UI/Theme.xaml"/>
  </Window.Resources>
  <Window.Style>
    <StaticResource ResourceKey="Forge3DWindow"/>
  </Window.Style>
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="Configurações"/>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <Button x:Name="TestButton" DockPanel.Dock="Left" Content="Testar motor" Margin="0"/>
      <Button x:Name="LogsButton" DockPanel.Dock="Left" Content="Abrir registros"/>
      <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancelar" IsCancel="True"/>
      <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Salvar" Style="{StaticResource Primary}" IsDefault="True"/>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Padrões de conversão">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Nível padrão"/>
            <ComboBox x:Name="LevelBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,2"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Categoria padrão"/>
            <ComboBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Value" Margin="0,2"/>
            <CheckBox x:Name="AskBBox" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,2"
                      Content="Perguntar antes de gerar em Nível B quando o Nível C não for possível"/>
            <CheckBox x:Name="FlexBox" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,2" Content="Rodar o teste de flexão no Revit antes de salvar"/>
            <CheckBox x:Name="LoadBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,2" Content="Oferecer inserção no projeto ao final"/>
            <CheckBox x:Name="AiMaskBox" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,2" Content="Usar IA para remover o fundo das imagens (se instalada)"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="6" Text="Tolerância de aproximação (mm)"/>
            <TextBox x:Name="FitTolBox" Grid.Row="6" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,2"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="7" Text="Máx. triângulos em formas livres"/>
            <TextBox x:Name="MaxFacesBox" Grid.Row="7" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,2"/>
          </Grid>
        </GroupBox>
        <GroupBox Header="Pastas e programas (vazio = automático)">
          <Grid x:Name="PathsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Label}" Text="Pasta das famílias geradas"/>
            <TextBox x:Name="OutputBox" Grid.Column="1" Margin="0,2"/>
            <Button Grid.Column="2" Content="…" MinWidth="32" Tag="OutputBox|folder"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Modelo de família (.rft)"/>
            <TextBox x:Name="TemplateBox" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
            <Button Grid.Row="1" Grid.Column="2" Content="…" MinWidth="32" Tag="TemplateBox|Modelo de família (*.rft)|*.rft"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Pasta do motor"/>
            <TextBox x:Name="EngineBox" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
            <Button Grid.Row="2" Grid.Column="2" Content="…" MinWidth="32" Tag="EngineBox|folder"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="3" Text="Python do motor"/>
            <TextBox x:Name="PythonBox" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
            <Button Grid.Row="3" Grid.Column="2" Content="…" MinWidth="32" Tag="PythonBox|Python (python.exe)|python.exe"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="4" Text="Modelos de IA"/>
            <TextBox x:Name="ModelsBox" Grid.Row="4" Grid.Column="1" Margin="0,2"/>
            <Button Grid.Row="4" Grid.Column="2" Content="…" MinWidth="32" Tag="ModelsBox|folder"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="5" Text="3ds Max (3dsmaxbatch.exe)"/>
            <TextBox x:Name="MaxBox" Grid.Row="5" Grid.Column="1" Margin="0,2"/>
            <Button Grid.Row="5" Grid.Column="2" Content="…" MinWidth="32" Tag="MaxBox|3dsmaxbatch.exe|3dsmaxbatch.exe"/>
            <TextBlock Style="{StaticResource Label}" Grid.Row="6" Text="SketchUp (SketchUp.exe)"/>
            <TextBox x:Name="SketchUpBox" Grid.Row="6" Grid.Column="1" Margin="0,2"/>
            <Button Grid.Row="6" Grid.Column="2" Content="…" MinWidth="32" Tag="SketchUpBox|SketchUp.exe|SketchUp.exe"/>
          </Grid>
        </GroupBox>
        <GroupBox Header="Diagnóstico do motor">
          <TextBox x:Name="DiagnosticBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="140"
                   VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Text="Clique em &quot;Testar motor&quot;."/>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
