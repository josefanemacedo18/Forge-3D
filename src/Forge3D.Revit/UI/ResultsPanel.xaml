<UserControl x:Class="Forge3D.Revit.UI.ResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Forge3D.Revit.UI">
  <UserControl.Resources>
    <ResourceDictionary Source="/Forge3D.Revit;component/UI/Theme.xaml"/>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="3*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="2*" MinWidth="320"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
      <local:PreviewViewport x:Name="Preview"/>
      <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8" Padding="8,4" Background="#E6FFFFFF" CornerRadius="3">
        <StackPanel Orientation="Horizontal">
          <Rectangle Width="12" Height="12" Fill="#2F9E44" Margin="0,0,4,0"/><TextBlock Text="Nível C" Margin="0,0,12,0"/>
          <Rectangle Width="12" Height="12" Fill="#F59F00" Margin="0,0,4,0"/><TextBlock Text="Nível B" Margin="0,0,12,0"/>
          <Rectangle Width="12" Height="12" Fill="#868E96" Margin="0,0,4,0"/><TextBlock Text="Forma livre / fixa"/>
        </StackPanel>
      </Border>
      <TextBlock VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" Style="{StaticResource Hint}"
                 Text="Arraste para girar · roda do mouse para zoom · duplo clique para enquadrar"/>
    </Grid>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Border x:Name="LevelBadge" CornerRadius="4" Padding="10,6" HorizontalAlignment="Left">
          <TextBlock x:Name="LevelText" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
        </Border>
        <TextBlock x:Name="EnvelopeText" Margin="0,8,0,0"/>
        <TextBlock x:Name="CoverageText" Style="{StaticResource Hint}"/>
        <TextBlock x:Name="SourceText" Style="{StaticResource Hint}" Margin="0,2,0,0"/>

        <TextBlock Text="Peças" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <ListView x:Name="PartsList" MaxHeight="190">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Peça" Width="150" DisplayMemberBinding="{Binding Name}"/>
              <GridViewColumn Header="Forma" Width="110" DisplayMemberBinding="{Binding Kind}"/>
              <GridViewColumn Header="Nível" Width="50" DisplayMemberBinding="{Binding Level}"/>
            </GridView>
          </ListView.View>
        </ListView>

        <TextBlock Text="Parâmetros da família" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <ListView x:Name="ParamsList" MaxHeight="230">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Parâmetro" Width="170" DisplayMemberBinding="{Binding Name}"/>
              <GridViewColumn Header="Valor" Width="80" DisplayMemberBinding="{Binding Value}"/>
              <GridViewColumn Header="Faixa segura (mm)" Width="120" DisplayMemberBinding="{Binding Range}"/>
            </GridView>
          </ListView.View>
        </ListView>

        <TextBlock x:Name="BlockersTitle" Text="Por que não chegou ao Nível C" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource Warn}"/>
        <TextBlock x:Name="BlockersText" TextWrapping="Wrap"/>
        <TextBlock x:Name="WarningsTitle" Text="Avisos" FontWeight="SemiBold" Margin="0,12,0,4"/>
        <TextBlock x:Name="WarningsText" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
