<Window x:Class="Forge3D.Revit.UI.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forge 3D — Biblioteca" Width="900" Height="560" MinWidth="640" MinHeight="400">
  <Window.Resources>
    <ResourceDictionary Source="/Forge3D.Revit;component/UI/Theme.xaml"/>
  </Window.Resources>
  <Window.Style>
    <StaticResource ResourceKey="Forge3DWindow"/>
  </Window.Style>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource Title}" Text="Famílias geradas pelo Forge 3D"/>
      <TextBox x:Name="SearchBox" Margin="0,8,0,0" ToolTip="Buscar por nome, categoria ou arquivo de origem"/>
    </StackPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <Button x:Name="FolderButton" DockPanel.Dock="Left" Content="Abrir pasta" Margin="0"/>
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Fechar" IsCancel="True"/>
      <Button x:Name="InsertButton" DockPanel.Dock="Right" Content="Inserir no projeto" Style="{StaticResource Primary}"/>
    </DockPanel>
    <ListView x:Name="List" Margin="0,10,0,0">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Família" Width="230" DisplayMemberBinding="{Binding Name}"/>
          <GridViewColumn Header="Categoria" Width="150" DisplayMemberBinding="{Binding Category}"/>
          <GridViewColumn Header="Nível" Width="50" DisplayMemberBinding="{Binding Level}"/>
          <GridViewColumn Header="Origem" Width="200" DisplayMemberBinding="{Binding Source}"/>
          <GridViewColumn Header="Criada em" Width="130" DisplayMemberBinding="{Binding Created}"/>
        </GridView>
      </ListView.View>
    </ListView>
  </DockPanel>
</Window>
