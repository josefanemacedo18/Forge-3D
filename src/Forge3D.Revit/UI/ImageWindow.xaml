<Window x:Class="Forge3D.Revit.UI.ImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Forge3D.Revit.UI"
        Title="Forge 3D — Família a partir de imagem" Width="1180" Height="780" MinWidth="960" MinHeight="620"
        AllowDrop="True">
  <Window.Resources>
    <ResourceDictionary Source="/Forge3D.Revit;component/UI/Theme.xaml"/>
  </Window.Resources>
  <Window.Style>
    <StaticResource ResourceKey="Forge3DWindow"/>
  </Window.Style>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Style="{StaticResource Title}" Text="Gerar família a partir de uma imagem"/>
      <TextBlock Style="{StaticResource Hint}"
                 Text="Use uma foto do objeto com fundo liso (ou PNG com transparência). Informe uma medida real para a escala. Tudo roda neste computador, sem internet."/>
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource Label}" Text="Imagem"/>
        <TextBox x:Name="FileBox" Grid.Column="1"/>
        <Button x:Name="BrowseButton" Grid.Column="2" Content="Procurar…"/>
      </Grid>
    </StackPanel>

    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <Button x:Name="GenerateButton" DockPanel.Dock="Left" Content="Gerar" Margin="0" Style="{StaticResource Primary}"/>
      <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="Cancelar" Visibility="Collapsed"/>
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Fechar" IsCancel="True"/>
      <Button x:Name="BuildButton" DockPanel.Dock="Right" Content="Criar família" IsEnabled="False" Style="{StaticResource Primary}"/>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Visibility="Hidden"/>
      <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
    </StackPanel>

    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}" Height="230">
            <Image x:Name="SilhouetteImage" Stretch="Uniform" Margin="4"/>
          </Border>
          <TextBlock x:Name="AnalysisText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>

          <TextBlock Text="Estratégia" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <ComboBox x:Name="StrategyBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>

          <TextBlock Text="Medida real de referência" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="ReferenceBox" SelectedIndex="0">
              <ComboBoxItem Content="Altura do objeto" Tag="altura"/>
              <ComboBoxItem Content="Largura do objeto" Tag="largura"/>
            </ComboBox>
            <TextBox x:Name="ReferenceValueBox" Grid.Column="2"/>
            <TextBlock Grid.Column="3" Text=" mm" VerticalAlignment="Center"/>
          </Grid>

          <TextBlock Text="Profundidade (só extrusão)" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="DepthBox" Width="90"/>
            <TextBlock Text=" mm (vazio = automática)" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
          </StackPanel>

          <TextBlock Text="Nível" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <ComboBox x:Name="LevelBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
          <TextBlock Text="Categoria" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <ComboBox x:Name="CategoryBox" DisplayMemberPath="Label" SelectedValuePath="Value"/>
          <TextBlock Text="Nome da família" FontWeight="SemiBold" Margin="0,12,0,4"/>
          <TextBox x:Name="NameBox"/>
          <TextBlock x:Name="AiText" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Column="2">
        <Border x:Name="EmptyState" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"
                     Text="Escolha a imagem e clique em Gerar. A prévia e os parâmetros aparecem aqui."/>
        </Border>
        <local:ResultsPanel x:Name="Results" Visibility="Collapsed"/>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
